# ═══ JARVIS — copie este arquivo para .env e preencha ═══

# Wake word (obrigatório) — chave grátis em https://console.picovoice.ai
PICOVOICE_ACCESS_KEY=

# Cérebro (obrigatório) — chave grátis em https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELO=llama-3.3-70b-versatile
# Alternativas:
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1        LLM_MODELO=gpt-4o-mini
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODELO=meta-llama/llama-3.3-70b-instruct
#   Ollama local: LLM_BASE_URL=http://localhost:11434/v1       LLM_MODELO=llama3.2  (LLM_API_KEY=ollama)

# Voz falada (opcional) — outras: pt-BR-FranciscaNeural (feminina)
TTS_VOZ=pt-BR-AntonioNeural

# Sensibilidade do microfone (opcional) — aumente se ele demora a parar de
# gravar, diminua se corta o fim das frases (padrão 0.008)
VAD_LIMIAR=0.008
