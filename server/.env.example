[TEMPLATE]
# ── Supabase (Project Settings → API) ─────────────────────────────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...chave-service-role...   # server-only

# ── Google Places API (New) — empresas reais, em tempo real ───────
# OPCIONAL: sem chave, o backend usa o OpenStreetMap (Overpass),
# gratuito e sem cartão. Com chave, usa o Google automaticamente.
GOOGLE_MAPS_API_KEY=
# Para usar o Google: ative "Places API (New)" no Google Cloud.
# Endpoint usado: POST https://places.googleapis.com/v1/places:searchText

# ── Gerador de landing pages (IA) ─────────────────────────────────
# Mesmo formato OpenAI — Groq é grátis: https://console.groq.com
LLM_API_KEY=gsk...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELO=openai/gpt-oss-120b
# Atenção: os modelos llama-3.3-70b-versatile e llama-3.1-8b-instant
# foram descontinuados pela Groq (ago/2026). Veja os atuais em
# https://console.groq.com/docs/models

# Opcional: fotos reais do nicho (https://unsplash.com/developers).
# Com a chave, as páginas recebem até 6 fotos do segmento (hero + galeria).
# Sem a chave, o site usa arte em gradiente/SVG premium (funciona igual).
UNSPLASH_ACCESS_KEY=

# ── App ───────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
